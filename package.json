{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "postcss": {
      "nanoid": "^3.3.18"
    }
  },
  "scripts": {
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "preview:web": "npm run preview -w web",
    "test:web": "npm run test -w web",
    "test:web:cov": "npm run test:coverage -w web",
    "lint:web": "npm run lint -w web",
    "typecheck:web": "npm run typecheck -w web",
    "lint:py": "uv run --locked --no-build ruff format --check packages agent scripts && uv run --locked --no-build ruff check packages agent scripts",
    "lint:imports": "uv run --locked --no-build lint-imports --config import-linter.ini",
    "typecheck:py": "uv run --locked --no-build mypy packages agent",
    "test:py": "uv run --locked --no-build pytest -q --cov=agent --cov=packages --cov-branch --cov-report=term --cov-fail-under=90",
    "audit:web": "npm audit --audit-level=high",
    "audit:py": "uv run --project tools/audit --locked --no-build python scripts/pip_audit.py",
    "eval": "uv run --locked --no-build pytest agent/tests/eval -q",
    "eval:update": "uv run --locked --no-build python scripts/update_eval_baseline.py",
    "graph": "uv run --locked --no-build python scripts/gen_dep_graph.py",
    "graph:check": "uv run --locked --no-build python scripts/gen_dep_graph.py --check",
    "docs:i18n": "uv run --locked --no-build python scripts/check_docs_i18n.py",
    "docs:links": "uv run --locked --no-build python scripts/check_doc_links.py",
    "gate:py": "npm run lint:py && npm run lint:imports && npm run typecheck:py && npm run test:py && npm run graph:check",
    "gate:web": "npm run typecheck:web && npm run lint:web && npm run test:web && npm run i18n:web && npm run format:web",
    "i18n:web": "npm run i18n:check -w web",
    "format:web": "npm run format:check -w web",
    "gate": "npm run gate:py && npm run gate:web"
  }
}
