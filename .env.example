# Voyager environment variable example - copy to the repo root as `.env` and adjust as needed.
# Never commit a `.env` containing real secrets.
#
# The composition root (host.assemble) seeds os.environ from this file at import
# time; variables already present in the environment win.

# Required: key material for secrets.db (Fernet-derived). Must be a long random
# string; the documented example values are rejected. SECRETS_ENCRYPTION_KEY is
# preferred, SECRET_KEY is the fallback name (platform_secrets.key_material).
# SECRETS_ENCRYPTION_KEY=
# SECRET_KEY=

# Optional: comma-separated whitelist of domains the monolith assembles. Wins over
# the host.domains.enabled setting and over each module card's enabled_by_default,
# e.g. settings,llm,sources,notes,graph,office
# ENABLE_DOMAINS=

# Graph engine sidecar (optional; the in-process Python fallback works out of the
# box). The address the graph domain connects to is the `graph.engine.c_url`
# setting (default http://127.0.0.1:8123), not an environment variable. The
# sidecar process itself reads ENGINE_PORT (default 9750) and ENGINE_ALLOWED_ROOT;
# building it: packages/graph/src/graph/engines/c/core/README.md.
# ENGINE_PORT=9750
# ENGINE_ALLOWED_ROOT=

# Optional: directory for the LLM domain's rejected-request dump. When set,
# every non-2xx provider reply writes the full request/response pair there
# (llm/client.py and llm/stream.py) - the only way to see what a strict
# provider actually disliked. Diagnostics only; leave unset normally.
# LLM_DEBUG_DUMP_DIR=

# Optional: outbound proxy for provider / GitHub API calls. The httpx clients
# default to trust_env=True, so HTTPS_PROXY (plus HTTP_PROXY / ALL_PROXY /
# NO_PROXY) is read from the environment; a value here applies to all LLM and
# sources fetches. Leave unset for direct connections.
# HTTPS_PROXY=
# NO_PROXY=127.0.0.1,localhost

# Web dev server port (apps/web/vite.config.ts, default 5173). Read from the
# shell environment of the npm process, not from this file.
# VITE_PORT=5173
